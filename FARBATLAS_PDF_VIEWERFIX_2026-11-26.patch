+/* PDF viewer positioning and control repair, 2026-11-26 */
+.pdf-viewer{width:100vw;height:100vh;height:100dvh;max-width:none!important;max-height:none!important}
+.pdf-viewer:fullscreen,.pdf-browser-fullscreen{width:100vw!important;height:100vh!important;height:100dvh!important}
+.pdf-toolbar{overflow-x:auto;scrollbar-width:thin}
+.pdf-tool.active,.pdf-tool[aria-pressed="true"]{background:#24bfd0;color:#042b3b;box-shadow:inset 0 0 0 2px #baf7ff}
+.pdf-stage{touch-action:none;box-sizing:border-box;scrollbar-gutter:stable both-edges}
+.pdf-stage.is-pannable{cursor:grab}
+.pdf-stage.dragging{cursor:grabbing;user-select:none}
+.pdf-pages{width:max-content;min-width:100%;min-height:100%;box-sizing:border-box;transform-origin:center center}
+.pdf-pages.is-contained{align-items:center}
+.pdf-page canvas{display:block;max-width:none!important;max-height:none!important}
+@media(max-width:760px){.pdf-toolbar{align-content:flex-start}.pdf-tool{white-space:nowrap}.pdf-pages{min-width:100%;min-height:100%}}
