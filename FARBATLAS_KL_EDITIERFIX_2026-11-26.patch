diff --git a/course-leader-client.js b/course-leader-client.js
--- a/course-leader-client.js
+++ b/course-leader-client.js
@@ -902,6 +902,32 @@
       setStatus('Akademischer Link lokal vorbereitet. Bitte anschließend serverseitig speichern.');
     };
   }
+  function installCourseRecordEditClickHandler() {
+    document.addEventListener('click', (event) => {
+      const button = event.target?.closest?.('.move');
+      if (!button || !courseToken || !courseProfile) return;
+      if (!document.body.classList.contains('course-leader-mode') || document.body.classList.contains('admin-mode')) return;
+
+      // Im KL-Modus den Klick direkt übernehmen. Damit ist die Bearbeitung
+      // unabhängig davon, wann rebuild()/bindPhotos() den Karten-Handler setzte.
+      event.preventDefault();
+      event.stopImmediatePropagation();
+
+      if (!selectedDataset) {
+        setStatus('Bitte den zugewiesenen Datensatz zuerst über den Kursleiter-Bereich öffnen.', 'error');
+        return;
+      }
+      const recordId = String(button.dataset.id || '');
+      const record = typeof records !== 'undefined' && Array.isArray(records)
+        ? records.find((entry) => entry.id === recordId)
+        : null;
+      if (!record) {
+        setStatus('Der Datensatz-Eintrag konnte nicht geöffnet werden. Bitte den Datensatz erneut laden.', 'error');
+        return;
+      }
+      openCourseRecordEditor(record);
+    }, true);
+  }
   function installEditorOverrides() {
     if (typeof openKnowledge === 'function') {
       const originalKnowledge = openKnowledge;
@@ -1140,6 +1169,7 @@
     installStyles();
     installCoursePanel();
