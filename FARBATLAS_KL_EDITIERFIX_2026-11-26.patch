diff --git a/test/course-leader-edit-click.test.mjs b/test/course-leader-edit-click.test.mjs
new file mode 100644
--- /dev/null
+++ b/test/course-leader-edit-click.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const course = fs.readFileSync(new URL('../course-leader-client.js', import.meta.url), 'utf8');
+
+test('KL animal edit click is handled directly in the capture phase', () => {
+  assert.match(course, /function installCourseRecordEditClickHandler\(\)/);
+  assert.match(course, /event\.target\?\.closest\?\.\('\.move'\)/);
+  assert.match(course, /event\.stopImmediatePropagation\(\)/);
+  assert.match(course, /openCourseRecordEditor\(record\)/);
+  assert.match(course, /\}, true\);/);
+  assert.match(course, /installCourseRecordEditClickHandler\(\);/);
+});
+
+test('KL click handler does not replace the administrator editor', () => {
+  assert.match(course, /document\.body\.classList\.contains\('course-leader-mode'\)/);
+  assert.match(course, /document\.body\.classList\.contains\('admin-mode'\)/);
+  assert.match(course, /!courseToken \|\| !courseProfile/);
+});
+
+test('KL click handler reports missing dataset context instead of failing silently', () => {
+  assert.match(course, /if \(!selectedDataset\)/);
+  assert.match(course, /Bitte den zugewiesenen Datensatz zuerst über den Kursleiter-Bereich öffnen\./);
+  assert.match(course, /records\.find\(\(entry\) => entry\.id === recordId\)/);
+  assert.match(course, /Der Datensatz-Eintrag konnte nicht geöffnet werden\./);
+});
+
+test('the previously installed dataset save guard remains present', () => {
+  assert.match(course, /let datasetRecordKeys = new Set\(\);/);
+  assert.match(course, /datasetRecordKeys/);
+  assert.match(course, /function collectCourseChanges\(\)/);
+});
